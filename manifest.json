{
  "manifest_version": 2,
  "name": "SmartMarkr 智签管家",
  "version": "1.0.0",
  "description": "SmartMarkr - 智能书签管理工具：重复检测、空文件夹清理、异常链接检测、智能归档，让书签井井有条！",
  "homepage_url": "https://github.com/afei8732/SmartMarkr-PRO",
  "browser_action": {
    "default_title": "SmartMarkr 智签管家",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ],
    "persistent": false
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartmarkr@github.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
