{
  "manifest_version": 3,
  "name": "SmartMarkr 智签管家",
  "version": "2.1.0",
  "description": "SmartMarkr 智签管家 2.1 - 书签清理与归档：重复检测、失效链接检测、空文件夹清理、智能归档（本地分类器 + 可选 AI 分类）、快照备份与导入导出。",
  "homepage_url": "https://github.com/afei8732/SmartMarkr-PRO",
  "action": {
    "default_title": "SmartMarkr 智签管家",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartmarkr@github.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
